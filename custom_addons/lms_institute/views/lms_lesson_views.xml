<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lms_lesson_view_search" model="ir.ui.view">
        <field name="name">lms.lesson.search</field>
        <field name="model">lms.lesson</field>
        <field name="arch" type="xml">
            <search string="Lessons">
                <field name="name"/>
                <field name="course_id"/>
                <group>
                    <filter name="group_course" string="Course" context="{'group_by': 'course_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="lms_lesson_view_list" model="ir.ui.view">
        <field name="name">lms.lesson.list</field>
        <field name="model">lms.lesson</field>
        <field name="arch" type="xml">
            <list string="Lessons">
                <field name="sequence" widget="handle"/>
                <field name="course_id"/>
                <field name="name"/>
                <field name="duration_minutes"/>
            </list>
        </field>
    </record>

    <record id="lms_lesson_view_form" model="ir.ui.view">
        <field name="name">lms.lesson.form</field>
        <field name="model">lms.lesson</field>
        <field name="arch" type="xml">
            <form string="Lesson">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="course_id"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="duration_minutes"/>
                        </group>
                    </group>
                    <field name="content"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="lms_lesson_action" model="ir.actions.act_window">
        <field name="name">Lessons</field>
        <field name="res_model">lms.lesson</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_course': 1}</field>
    </record>
</odoo>
